{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --ignore-scripts",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/",
      "headers": [{ "key": "Permissions-Policy", "value": "camera=(), microphone=()" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Permissions-Policy", "value": "camera=(), microphone=()" }]
    },
    {
      "source": "/sender.html",
      "headers": [{ "key": "Permissions-Policy", "value": "camera=(), microphone=()" }]
    },
    {
      "source": "/receiver.html",
      "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), microphone=()" }]
    }
  ],
  "redirects": [
    { "source": "/send", "destination": "/sender.html", "permanent": false },
    { "source": "/receive", "destination": "/receiver.html", "permanent": false }
  ]
}
